{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "develop",
  "namedInputs": {
    "default": ["{projectRoot}/**/*"],
    "toolchain": [
      "{workspaceRoot}/eslint.config.mjs",
      "{workspaceRoot}/.prettierrc.json",
      "{workspaceRoot}/tools/claude-code-types/**/*",
      {
        "runtime": "claude --version"
      }
    ]
  },
  "targetDefaults": {
    "kit-check": {
      "cache": true,
      "inputs": [
        "{projectRoot}/package.json",
        "{projectRoot}/src/_kit/**/*",
        "{workspaceRoot}/libs/mod-kit/src/**/*",
        "{workspaceRoot}/tools/sync-kit.mjs"
      ]
    },
    "lint": {
      "cache": true,
      "dependsOn": ["kit-check"],
      "inputs": ["default", "^default", "toolchain"]
    },
    "typecheck": {
      "cache": true,
      "dependsOn": ["kit-check"],
      "inputs": ["default", "^default", "toolchain"]
    },
    "validate": {
      "cache": true,
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "claude --version"
        }
      ]
    },
    "test": {
      "cache": true,
      "dependsOn": ["kit-check"],
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "claude --version"
        }
      ]
    }
  },
  "release": {
    "projects": ["mods/*"],
    "projectsRelationship": "independent",
    "releaseTag": {
      "pattern": "{projectName}@{version}"
    },
    "version": {
      "conventionalCommits": true,
      "versionActions": "./tools/release/version-actions.cjs"
    },
    "changelog": {
      "projectChangelogs": {
        "createRelease": "github"
      },
      "workspaceChangelog": false
    },
    "git": {
      "commit": true,
      "tag": true
    }
  },
  "analytics": false
}
