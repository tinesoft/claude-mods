{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "craftory",
  "projectType": "application",
  "sourceRoot": "mods/craftory",
  "targets": {
    "lint": {
      "metadata": {
        "description": "Lint the mod with ESLint."
      },
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint .",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "metadata": {
        "description": "Type-check the mod with tsc against the claude-code types, without emitting."
      },
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p . --noEmit",
        "cwd": "{projectRoot}"
      }
    },
    "validate": {
      "metadata": {
        "description": "Validate the plugin manifest and layout with `claude plugin validate --strict`, and check the vendored upstream templates for drift."
      },
      "executor": "nx:run-commands",
      "options": {
        "command": "claude plugin validate . --strict && node ../../tools/vendor-craftory-templates.mjs --check",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "metadata": {
        "description": "Run the mod's tests with `claude plugin test` on the Claude Code version CI pins."
      },
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../tools/claude-pinned.mjs plugin test .",
        "cwd": "{projectRoot}"
      }
    },
    "dev": {
      "metadata": {
        "description": "Start Claude Code with this mod loaded from the repo root, for manual testing."
      },
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "claude --plugin-dir {projectRoot}",
        "cwd": "{workspaceRoot}"
      }
    },
    "install": {
      "metadata": {
        "description": "Replace the installed tinesoft-mods marketplace with this repo and install this mod from it."
      },
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "claude plugin marketplace remove tinesoft-mods || true",
          "claude plugin install craftory --marketplace ./"
        ],
        "parallel": false,
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
