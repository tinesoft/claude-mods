{
  "model": "haiku",
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": ["Read", "Bash(cat:*)", "mcp__github__list_issues", "Skill", "Agent", "Task"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "./.claude/hooks/block-secrets.sh" }]
      }
    ]
  }
}
